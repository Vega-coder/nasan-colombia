VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Número de WhatsApp de la tienda (formato internacional, sin +)
VITE_STORE_WHATSAPP=573000000000
# Acceso al panel /admin en modo demo (sin Supabase). Con Supabase se usa Supabase Auth.
VITE_DEMO_ADMIN_EMAIL=admin@aromapremium.test
VITE_DEMO_ADMIN_PASSWORD=AromaDemo2026!

# Groq AI Chatbot (Asesor Virtual)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Pasarela de pagos Wompi (Bancolombia)
# Sandbox inicia con pub_test_ / Producción con pub_prod_
VITE_WOMPI_PUBLIC_KEY=pub_test_Q5yDA9xoKdePium1bpvd9quAwugOZ2Mg
# Secreto para firma de integridad SHA-256 (test_integrity_... o prod_integrity_...)
VITE_WOMPI_INTEGRITY_SECRET=

# =====================================================================
# Plataforma de Envíos y Transportadoras (Mi Paquete / Envia.com)
# =====================================================================
# Proveedor: mipaquete o envia
VITE_SHIPPING_PROVIDER=mipaquete
# API Key / Credencial de desarrollador provista por Mi Paquete o Envia.com
VITE_SHIPPING_API_KEY=
# Entorno sandbox/pruebas: true o false
VITE_SHIPPING_SANDBOX=false
# Transportadora por defecto: coordinadora, servientrega, envia, interrapidisimo, tcc
VITE_SHIPPING_DEFAULT_CARRIER=coordinadora
# Auto-generar guía apenas se confirme el pago en Wompi: true o false
VITE_SHIPPING_AUTO_GENERATE=true

# Datos de origen (Remitente - Tienda Aroma Premium)
VITE_STORE_ORIGIN_NAME=Aroma Premium Colombia
VITE_STORE_ORIGIN_PHONE=573146160642
VITE_STORE_ORIGIN_EMAIL=contacto@aromapremium.co
VITE_STORE_ORIGIN_ADDRESS=Calle 10 # 43E-20, El Poblado
